<Project>
  <PropertyGroup>
    <VersionPrefix>1.0.1</VersionPrefix>
    <PackageVersion>$(VersionPrefix)</PackageVersion>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
    <BaseIntermediateOutputPath>$(TEMP)\WpfApp1\$(MSBuildProjectName)\obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(TEMP)\WpfApp1\$(MSBuildProjectName)\obj\</MSBuildProjectExtensionsPath>
  </PropertyGroup>
</Project>
